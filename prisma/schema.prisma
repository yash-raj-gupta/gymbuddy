// GymBuddy schema — offline-first workout tracker.
// Models derived from gymbuddy-prd.md §4 (MVP scope).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  LIFETIME
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
  CARDIO
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises Exercise[]
  routines  Routine[]
  workouts  Workout[]
}

// Seeded catalogue exercises have userId = null; custom ones belong to a user.
model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  isCustom    Boolean     @default(false)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  routineItems RoutineExercise[]
  setLogs      SetLog[]

  @@index([userId])
  @@index([muscleGroup])
}

model Routine {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items RoutineExercise[]

  @@index([userId])
}

model RoutineExercise {
  id         String   @id @default(cuid())
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order      Int

  @@unique([routineId, exerciseId])
  @@index([routineId])
}

model Workout {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  note       String?
  // Idempotency key for the offline IndexedDB queue → server sync.
  clientId   String?   @unique

  sets SetLog[]

  @@index([userId])
  @@index([userId, startedAt])
}

model SetLog {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  reps       Int
  weight     Float
  rpe        Float?
  done       Boolean  @default(true)
  order      Int
  createdAt  DateTime @default(now())

  @@index([workoutId])
  @@index([exerciseId])
}
